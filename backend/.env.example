# Copia este archivo como backend/.env y completa los valores.
# backend/.env está en .gitignore: nunca lo subas al repositorio.

# --- Base de datos (PostgreSQL) ---
# Coincide con el contenedor de docker-compose.yml (docker compose up -d --wait).
DATABASE_URL=postgresql://crave:crave_dev@localhost:5432/crave_db

# --- JWT (obligatoria: la app no arranca sin ella) ---
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Orígenes permitidos separados por comas (p. ej. Flutter web en desarrollo).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Gemini AI (opcional) ---
# Sin clave, o si Gemini falla, el Genio usa recomendaciones por palabras clave.
GEMINI_API_KEY=
# Modelo de Gemini; por defecto gemini-flash-latest (el Flash vigente).
GEMINI_MODEL=

# --- Reseñas ---
# Estado inicial de las reseñas nuevas: Approved (se publican al momento) o
# Pending (quedan ocultas hasta moderarlas). Otro valor impide arrancar.
REVIEW_DEFAULT_STATUS=Approved
